# Personal AI System - Gitignore
# Generated for secure public publication

# Virtual environments
venv/
.venv/
env/
ENV/

# Encryption keys (stored in user home)
.personal_ai_key
.personal_ai_*_key

# Vault data directory
.personal_ai_vault/
~/.personal_ai/bills.db

# Authentication
.personal_ai_auth

# ChromaDB vector store (RAG)
.chroma/

# Python bytecode
__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/
build/
dist/

# Environment variables (never commit these)
.env
*.env

# Ollama model cache (can be large)
~/.ollama/

# Test artifacts
.test_output/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# IDE
.vscode/
.idea/

# OS artifacts
.DS_Store