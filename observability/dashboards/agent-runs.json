{
 "uid": "pai-agent-runs",
 "title": "personal_ai \u00b7 Agent runs",
 "schemaVersion": 39,
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "refresh": "30s",
 "panels": [
  {
   "type": "stat",
   "title": "Runs",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(max_over_time(personal_ai_runs_total[$__range])) or vector(0)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "type": "stat",
   "title": "Failed/timeout steps",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 4,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(max_over_time(personal_ai_steps_total{status!=\"ok\"}[$__range])) or vector(0)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Steps by agent and status (total)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (agent, status) (personal_ai_steps_total)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "__auto"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Run latency p50/p95 (ms)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(personal_ai_run_duration_milliseconds_bucket[$__rate_interval])))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "__auto"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms"
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "Step latency p95 by agent (ms)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 24,
    "x": 0,
    "y": 12
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, agent) (rate(personal_ai_step_duration_milliseconds_bucket[$__rate_interval])))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "__auto"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms"
    },
    "overrides": []
   }
  },
  {
   "type": "table",
   "title": "Recent traces (click a trace id to open the span tree)",
   "datasource": {
    "type": "tempo",
    "uid": "tempo"
   },
   "gridPos": {
    "h": 9,
    "w": 24,
    "x": 0,
    "y": 20
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "tempo",
      "uid": "tempo"
     },
     "queryType": "traceql",
     "query": "{resource.service.name=\"personal_ai\"}",
     "limit": 20,
     "tableType": "traces"
    }
   ]
  }
 ],
 "tags": [
  "personal_ai"
 ]
}
