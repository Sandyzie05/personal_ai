{
 "uid": "pai-agent-runs",
 "title": "personal_ai \u00b7 Agent runs",
 "panels": [
  {
   "type": "stat",
   "title": "Runs (all jobs)",
   "description": "Top-level jobs in the time range: chat turns, Gmail syncs, Forecast/Trader agent runs, agent tool loops. Counted when their root trace ends.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(max_over_time(personal_ai_runs_total[$__range])) or vector(0)"
    }
   ]
  },
