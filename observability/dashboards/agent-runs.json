  {
   "type": "timeseries",
   "title": "Runs by job (total)",
   "description": "Running total of top-level jobs since the app started, split by job.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (run) (personal_ai_runs_total)",
     "legendFormat": "{{run}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Run latency p95 by job",
   "description": "95th percentile wall time of a top-level job.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le, run) (rate(personal_ai_run_duration_milliseconds_bucket[$__rate_interval])))",
     "legendFormat": "{{run}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms"
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "Coordinator steps by agent and status (total)",
